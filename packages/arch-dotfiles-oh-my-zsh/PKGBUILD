# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=arch-dotfiles-oh-my-zsh
pkgver=0.3.0
pkgrel=1
pkgdesc='Pinned, pacman-managed Oh My Zsh runtime'
arch=('any')
url='https://github.com/MichaelWeissDEV/dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('zsh' 'git')
optdepends=()
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')
_omz_commit=17a2b4c3a5855524ad4772a17ada0dc474e2fdf3
source+=("ohmyzsh-${_omz_commit}.tar.gz::https://codeload.github.com/ohmyzsh/ohmyzsh/tar.gz/${_omz_commit}")
sha256sums+=('eb6f2788316ff75f9be60c00372da0da97d4bcab202d64a9229e1f6365166932')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
    cp -a "$srcdir/ohmyzsh-$_omz_commit" "$pkgdir/usr/share/arch-dotfiles/oh-my-zsh"
}
