#!/usr/bin/env bash
# ============================================================================
# ~/git/dotfiles/scripts/adot - Unified Arch Linux Dotfiles CLI Program
# Exposed in ~/.local/bin as: adot, arch-dot, arch-dotfiles
# ============================================================================
# Usage:
#   adot install                        Complete setup (packages, subtrees, OMZ, symlinks, services)
#   adot update [all|<module>|system]   Update everything or a single component/subtree
#   adot status [--fetch]               Show live state of dotfiles, symlinks, subtrees, OMZ & packages
#   adot list [modules|subtrees|keys|commands|scripts|packages|links|docs]
#   adot keys [hypr|vim|nvim|tmux|terminals|shell|all]
#   adot commands                       List all custom CLI commands, shell functions & aliases
#   adot scripts                        List all helper scripts & CLI binaries
#   adot subtrees [status|pull|push] [target]
#   adot push [all|nvim|tmux|ghostty|kitty|foot|vim]
#   adot links                          Create/refresh all symlinks in ~/.config, ~ & ~/.local/bin
#   adot packages                       Install/update all managed Arch Linux packages via pacman
#   adot wallpapers [URL|--update]      Clone or update private wallpaper repository (pictures/)
#   adot docs                           Show all Read the Docs documentation URLs
# ============================================================================

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPTS_DIR="$(dirname "$SCRIPT_PATH")"
DOTFILES_DIR="$(cd "$SCRIPTS_DIR/.." && pwd)"
CONFIG_TARGET="${XDG_CONFIG_HOME:-$HOME/.config}"

# Catppuccin Mocha ANSI Colors
if [[ -t 1 ]]; then
    BLUE=$'\033[1;34m'
    GREEN=$'\033[1;32m'
    YELLOW=$'\033[1;33m'
    RED=$'\033[1;31m'
    MAUVE=$'\033[1;35m'
    TEAL=$'\033[1;36m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
else
    BLUE='' GREEN='' YELLOW='' RED='' MAUVE='' TEAL='' BOLD='' DIM='' RESET=''
fi

info()    { printf "${BLUE}[INFO]${RESET}  %s\n" "$*"; }
ok()      { printf "${GREEN}[OK]${RESET}    %s\n" "$*"; }
warn()    { printf "${YELLOW}[WARN]${RESET}  %s\n" "$*"; }
error()   { printf "${RED}[ERROR]${RESET} %s\n" "$*" >&2; }
section() { printf "\n${MAUVE}━━━ %s ━━━${RESET}\n" "$*"; }

# Managed configuration directories linked into ~/.config/<dir>
CONFIG_DIRS=(
    foot
    fuzzel
    ghostty
    gtk-3.0
    gtk-4.0
    hypr
    kitty
    libfm
    nvim
    pcmanfm
    tmux
    vim
    wallpaper
    waybar
    yazi
    zsh
)

SUBTREE_MODULES=(nvim tmux ghostty kitty foot vim)

# Managed official Arch Linux packages
PACMAN_PACKAGES=(
    # Hyprland & Wayland Desktop
    hyprland
    hyprpaper
    hyprlock
    hypridle
    waybar
    fuzzel
    xdg-desktop-portal-hyprland
    wl-clipboard
    grim
    slurp
    brightnessctl
    power-profiles-daemon

    # Audio (PipeWire), Network & Bluetooth
    pipewire
    pipewire-alsa
    pipewire-pulse
    pipewire-jack
    wireplumber
    gst-plugin-pipewire
    libpulse
    networkmanager
    bluez
    bluez-utils

    # Terminals & Shell Environment
    ghostty
    kitty
    foot
    zsh
    tmux

    # Editors & CLI Tools
    neovim
    vim
    git
    fzf
    zoxide
    ripgrep
    fd
    jq
    wget
    man-db
    man-pages

    # File Managers, Browser & Typography
    yazi
    pcmanfm
    firefox
    ttf-jetbrains-mono-nerd
    noto-fonts
)

get_module_desc() {
    case "$1" in
        foot)      echo "Lightweight Wayland terminal [Git Subtree: foot-config]" ;;
        fuzzel)    echo "Wayland app launcher, window switcher & sudo askpass prompt" ;;
        ghostty)   echo "GPU terminal [Git Subtree: ghostty-config]" ;;
        gtk-3.0)   echo "Catppuccin Mocha GTK3 theme & dark mode settings" ;;
        gtk-4.0)   echo "Catppuccin Mocha GTK4 theme & dark mode settings" ;;
        hypr)      echo "Hyprland compositor, slots 1..10/F1..F4, hyprlock & powermenu" ;;
        kitty)     echo "GPU terminal with Powerline tabs [Git Subtree: kitty-config]" ;;
        libfm)     echo "PCManFM / libfm backend configuration" ;;
        nvim)      echo "Reproducible offline-capable Neovim IDE [Git Subtree: nvim-config]" ;;
        pcmanfm)   echo "Lightweight GUI file manager configuration" ;;
        tmux)      echo "Portable fast terminal multiplexer [Git Subtree: tmux-config]" ;;
        vim)       echo "Zero-plugin standalone Vim configuration [Git Subtree: vim-config]" ;;
        wallpaper) echo "Multi-monitor hyprpaper manager (CLI 'wallpaper' + Fuzzel TUI)" ;;
        waybar)    echo "Top Wayland status bar & GTK power menu dropdown" ;;
        yazi)      echo "Terminal file manager with Catppuccin Mocha flavor" ;;
        zsh)       echo "Zsh shell, Oh My Zsh, zoxide (j/ji), FZF & custom aliases" ;;
        *)         echo "Configuration module" ;;
    esac
}

get_subtree_url() {
    case "$1" in
        nvim)    echo "https://github.com/MichaelWeissDEV/nvim-config.git" ;;
        tmux)    echo "https://github.com/MichaelWeissDEV/tmux-config.git" ;;
        ghostty) echo "https://github.com/MichaelWeissDEV/ghostty-config.git" ;;
        kitty)   echo "https://github.com/MichaelWeissDEV/kitty-config.git" ;;
        foot)    echo "https://github.com/MichaelWeissDEV/foot-config.git" ;;
        vim)     echo "https://github.com/MichaelWeissDEV/vim-config.git" ;;
    esac
}

get_subtree_docs() {
    case "$1" in
        nvim)    echo "https://nvim-config.readthedocs.io/en/latest/" ;;
        tmux)    echo "https://tmux-config.readthedocs.io/en/latest/" ;;
        ghostty) echo "https://ghostty-config.readthedocs.io/en/latest/" ;;
        kitty)   echo "https://kitty-config.readthedocs.io/en/latest/" ;;
        foot)    echo "https://arch-dotfiles.readthedocs.io/en/latest/terminals/" ;;
        vim)     echo "https://vim-config.readthedocs.io/en/latest/" ;;
    esac
}

# ============================================================================
# 1. ARCH LINUX PACKAGES
# ============================================================================
install_packages() {
    if ! command -v pacman >/dev/null 2>&1; then
        warn "pacman not found – skipping Arch package installation."
        return 0
    fi

    info "Installing/updating required Arch Linux packages via pacman (--needed)..."
    sudo pacman -Syu --needed "${PACMAN_PACKAGES[@]}"
    ok "All system packages are installed and up to date."
}

# ============================================================================
# 2. GIT SUBTREES (nvim, tmux, ghostty, kitty, foot & vim)
# ============================================================================
setup_subtrees() {
    "$SCRIPTS_DIR/update-subtrees.sh" setup
}

update_subtrees() {
    "$SCRIPTS_DIR/update-subtrees.sh" "${1:-all}"
}

# ============================================================================
# 3. OH MY ZSH & ZSH PLUGINS
# ============================================================================
setup_oh_my_zsh() {
    local omz_dir="$HOME/.oh-my-zsh"
    local plugins_dir="$omz_dir/custom/plugins"

    if [[ ! -d "$omz_dir" ]]; then
        info "Installing Oh My Zsh into ~/.oh-my-zsh..."
        git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$omz_dir"
        ok "Oh My Zsh installed."
    else
        ok "Oh My Zsh is already installed."
    fi

    mkdir -p "$plugins_dir" "$omz_dir/custom/themes"

    if [[ ! -d "$plugins_dir/zsh-autosuggestions" ]]; then
        info "Installing plugin zsh-autosuggestions..."
        git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git "$plugins_dir/zsh-autosuggestions"
    fi

    if [[ ! -d "$plugins_dir/zsh-syntax-highlighting" ]]; then
        info "Installing plugin zsh-syntax-highlighting..."
        git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git "$plugins_dir/zsh-syntax-highlighting"
    fi

    ok "Zsh plugins (zsh-autosuggestions, zsh-syntax-highlighting) are ready."
}

update_oh_my_zsh() {
    if [[ -d "$HOME/.oh-my-zsh/.git" ]]; then
        info "Updating Oh My Zsh & custom plugins..."
        git -C "$HOME/.oh-my-zsh" pull --ff-only || true
        for plugin_dir in "$HOME/.oh-my-zsh/custom/plugins"/*; do
            if [[ -d "$plugin_dir/.git" ]]; then
                git -C "$plugin_dir" pull --ff-only || true
            fi
        done
        ok "Oh My Zsh & plugins updated."
    else
        setup_oh_my_zsh
    fi
}

# ============================================================================
# 4. SYMLINKS, DIRECTORIES & PERMISSIONS
# ============================================================================
link_item() {
    local src="$1"
    local dst="$2"

    if [[ -L "$dst" ]]; then
        local current_target
        current_target="$(readlink "$dst")"
        if [[ "$current_target" == "$src" ]]; then
            return 0
        fi
        rm -f "$dst"
    elif [[ -e "$dst" ]]; then
        local backup="${dst}.bak.$(date +%Y%m%d_%H%M%S)"
        warn "Existing target '$dst' is not a symlink – backing up to '$backup'"
        mv "$dst" "$backup"
    fi

    ln -sfn "$src" "$dst"
}

setup_links() {
    info "Configuring symlinks from $DOTFILES_DIR to $CONFIG_TARGET, $HOME, and ~/.local/bin..."

    mkdir -p "$CONFIG_TARGET"
    mkdir -p "$HOME/Downloads"
    mkdir -p "$HOME/.local/state/vim/undo"
    mkdir -p "$HOME/.local/bin"
    mkdir -p "$DOTFILES_DIR/pictures"

    # 1. Link all managed module directories into ~/.config/<dir>
    for dir in "${CONFIG_DIRS[@]}"; do
        if [[ -e "$DOTFILES_DIR/$dir" ]]; then
            link_item "$DOTFILES_DIR/$dir" "$CONFIG_TARGET/$dir"
        else
            warn "Directory '$DOTFILES_DIR/$dir' does not exist – skipping."
        fi
    done

    # 2. Home directory symlinks
    link_item "$CONFIG_TARGET/zsh/zshrc"      "$HOME/.zshrc"
    link_item "$CONFIG_TARGET/tmux/tmux.conf" "$HOME/.tmux.conf"
    link_item "$CONFIG_TARGET/vim/vimrc"      "$HOME/.vimrc"

    # 3. CLI programs in ~/.local/bin (adot, arch-dot, arch-dotfiles, wallpaper)
    link_item "$SCRIPTS_DIR/adot"             "$HOME/.local/bin/adot"
    link_item "$SCRIPTS_DIR/adot"             "$HOME/.local/bin/arch-dot"
    link_item "$SCRIPTS_DIR/adot"             "$HOME/.local/bin/arch-dotfiles"
    link_item "$CONFIG_TARGET/wallpaper/wallpaper.sh" "$HOME/.local/bin/wallpaper"

    # 4. Oh My Zsh theme symlink
    if [[ -d "$HOME/.oh-my-zsh/custom/themes" ]]; then
        link_item "$CONFIG_TARGET/zsh/themes/catppuccin.zsh-theme" \
            "$HOME/.oh-my-zsh/custom/themes/catppuccin.zsh-theme"
    fi

    # 5. Ensure executable permissions on all scripts
    chmod +x "$DOTFILES_DIR/hypr/askpass.sh" \
             "$DOTFILES_DIR/hypr/powermenu.sh" \
             "$DOTFILES_DIR/hypr/windowswitcher.sh" \
             "$DOTFILES_DIR/wallpaper/wallpaper.sh" \
             "$SCRIPTS_DIR/adot" \
             "$SCRIPTS_DIR/install.sh" \
             "$SCRIPTS_DIR/install-links.sh" \
             "$SCRIPTS_DIR/install-wallpapers.sh" \
             "$SCRIPTS_DIR/update-subtrees.sh"

    ok "Symlinks configured in $CONFIG_TARGET (${#CONFIG_DIRS[@]} modules), ~/.local/bin (adot, arch-dot, arch-dotfiles, wallpaper) & ~."
}

# ============================================================================
# 5. SYSTEM SERVICES & DEFAULT LOGIN SHELL
# ============================================================================
setup_system() {
    if command -v systemctl >/dev/null 2>&1; then
        for svc in NetworkManager.service bluetooth.service power-profiles-daemon.service; do
            if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
                if ! systemctl is-enabled --quiet "$svc" 2>/dev/null; then
                    info "Enabling system service: $svc"
                    sudo systemctl enable --now "$svc" || warn "Could not enable $svc."
                fi
            fi
        done
    fi

    if command -v zsh >/dev/null 2>&1; then
        local current_shell zsh_path
        current_shell="$(getent passwd "$USER" | cut -d: -f7)"
        zsh_path="$(command -v zsh)"
        if [[ "$current_shell" != "$zsh_path" ]]; then
            info "Setting default login shell to $zsh_path..."
            chsh -s "$zsh_path" || warn "Could not change login shell automatically."
        fi
    fi

    ok "System services and default shell verified."
}

# ============================================================================
# 6. UNIFIED UPDATE ENGINE (Everything or Granular Component)
# ============================================================================
pull_dotfiles_repo() {
    if ! git -C "$DOTFILES_DIR" remote get-url origin >/dev/null 2>&1; then
        return 0
    fi

    if [[ -f "$DOTFILES_DIR/.git/MERGE_HEAD" ]]; then
        error "An unfinished Git merge is active in $DOTFILES_DIR!"
        warn "Run 'git -C $DOTFILES_DIR merge --abort' (or resolve conflicts) before updating."
        return 1
    fi

    if [[ -n "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
        warn "Working tree in $DOTFILES_DIR has uncommitted changes – skipping 'git pull'."
        return 1
    fi

    local branch
    branch="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
    info "Fetching and updating $DOTFILES_DIR (origin/$branch)..."
    git -C "$DOTFILES_DIR" fetch origin "$branch"

    local local_sha remote_sha
    local_sha="$(git -C "$DOTFILES_DIR" rev-parse HEAD)"
    remote_sha="$(git -C "$DOTFILES_DIR" rev-parse "origin/$branch")"

    if [[ "$local_sha" == "$remote_sha" ]]; then
        ok "Main dotfiles repository is already up to date (${local_sha:0:7})."
    elif git -C "$DOTFILES_DIR" merge-base --is-ancestor "$local_sha" "$remote_sha" 2>/dev/null; then
        git -C "$DOTFILES_DIR" merge --ff-only "origin/$branch"
        ok "Main dotfiles repository updated (${local_sha:0:7} -> ${remote_sha:0:7})."
    elif git -C "$DOTFILES_DIR" merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        ok "Main dotfiles repository is ahead of origin/$branch (${local_sha:0:7} vs ${remote_sha:0:7} — run 'adot push' to publish)."
    else
        warn "Local branch '$branch' and 'origin/$branch' have diverged – manual merge/rebase required."
        return 1
    fi
}

update_target() {
    local target="${1:-all}"
    case "$target" in
        all)
            section "1/6 Central Dotfiles Repository ($DOTFILES_DIR)"
            local before_adot_hash after_adot_hash
            before_adot_hash="$(sha256sum "$SCRIPTS_DIR/adot" 2>/dev/null | awk '{print $1}' || true)"
            pull_dotfiles_repo || warn "Dotfiles repository pull skipped."
            after_adot_hash="$(sha256sum "$SCRIPTS_DIR/adot" 2>/dev/null | awk '{print $1}' || true)"

            if [[ -n "$before_adot_hash" && -n "$after_adot_hash" && "$before_adot_hash" != "$after_adot_hash" && "${ADOT_REEXEC:-0}" != "1" ]]; then
                info "adot CLI was updated from remote – re-executing updated version..."
                ADOT_REEXEC=1 exec "$SCRIPTS_DIR/adot" update "$@"
            fi

            section "2/6 Embedded Git Subtrees (${SUBTREE_MODULES[*]})"
            update_subtrees all || warn "Subtree update skipped."

            section "3/6 Private Wallpaper Repository (pictures/)"
            if [[ -d "$DOTFILES_DIR/pictures/.git" ]]; then
                git -C "$DOTFILES_DIR/pictures" pull --ff-only || warn "Wallpaper repository pull skipped."
                ok "Private wallpaper repository updated."
            else
                info "No private wallpaper git repo in pictures/ – skipping."
            fi

            section "4/6 Oh My Zsh & Shell Plugins"
            update_oh_my_zsh

            section "5/6 Refreshing Symlinks & CLI Binaries"
            setup_links

            section "6/6 Arch Linux System Packages (pacman)"
            if [[ "${ADOT_NO_SYSTEM:-0}" == "1" ]]; then
                info "Skipping system package update (ADOT_NO_SYSTEM=1)."
            elif command -v pacman >/dev/null 2>&1; then
                sudo pacman -Syu --needed "${PACMAN_PACKAGES[@]}" || warn "System package update skipped or cancelled."
            else
                warn "pacman not found – skipping system package update."
            fi

            printf "\n"
            ok "Complete ecosystem update ('adot update') finished successfully!"
            ;;
        config|configs|nosystem|user)
            ADOT_NO_SYSTEM=1 update_target all
            ;;
        nvim|tmux|ghostty|kitty|foot|vim)
            section "Updating Git Subtree: $target"
            update_subtrees "$target"
            setup_links
            ;;
        subtrees|subtree)
            section "Updating All 6 Git Subtrees (${SUBTREE_MODULES[*]})"
            update_subtrees "${2:-all}"
            setup_links
            ;;
        dotfiles|repo|self)
            section "Updating Dotfiles Repository ($DOTFILES_DIR)"
            pull_dotfiles_repo
            setup_links
            ;;
        system|packages|pkgs|pacman)
            section "Updating Arch Linux Packages"
            install_packages
            ;;
        omz|zsh|plugins)
            section "Updating Oh My Zsh & Zsh Plugins"
            update_oh_my_zsh
            ;;
        wallpapers|pictures|wp)
            section "Updating Private Wallpaper Repository"
            "$SCRIPTS_DIR/install-wallpapers.sh" --update
            ;;
        links|symlinks)
            setup_links
            ;;
        *)
            error "Unknown update target: '$target'"
            echo "Allowed targets: all, config, nvim, tmux, ghostty, kitty, foot, vim, subtrees, dotfiles, system/packages, zsh/omz, wallpapers, links"
            exit 1
            ;;
    esac
}

# ============================================================================
# 7. STATUS & INSPECTION DASHBOARD (adot status)
# ============================================================================
show_status() {
    local do_fetch=0
    if [[ "${1:-}" == "--fetch" || "${1:-}" == "-f" ]]; then
        do_fetch=1
    fi

    section "Arch Dotfiles Ecosystem Status ($DOTFILES_DIR)"
    local branch head_sha dirty_count
    branch="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    head_sha="$(git -C "$DOTFILES_DIR" log -1 --format="%h (%cr) — %s" 2>/dev/null || echo "n/a")"
    dirty_count="$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"

    printf "  ${BOLD}%-18s${RESET} %s\n" "Repository:" "$DOTFILES_DIR (branch: $branch)"
    printf "  ${BOLD}%-18s${RESET} %s\n" "Latest Commit:" "$head_sha"
    if [[ "$dirty_count" -eq 0 ]]; then
        printf "  ${BOLD}%-18s${RESET} ${GREEN}clean (0 uncommitted files)${RESET}\n" "Working Tree:"
    else
        printf "  ${BOLD}%-18s${RESET} ${YELLOW}%s modified/untracked file(s)${RESET}\n" "Working Tree:" "$dirty_count"
    fi

    section "CLI Binaries (~/.local/bin)"
    for bin in adot arch-dot arch-dotfiles wallpaper; do
        local bin_path="$HOME/.local/bin/$bin"
        if [[ -L "$bin_path" && -x "$bin_path" ]]; then
            printf "  ${GREEN}✔${RESET} %-16s -> %s\n" "$bin" "$(readlink "$bin_path")"
        else
            printf "  ${RED}✘${RESET} %-16s (missing — run 'adot links')\n" "$bin"
        fi
    done

    section "Managed Configuration Symlinks (${#CONFIG_DIRS[@]} modules in ~/.config)"
    local linked_ok=0 linked_bad=0
    for dir in "${CONFIG_DIRS[@]}"; do
        local dst="$CONFIG_TARGET/$dir"
        local src="$DOTFILES_DIR/$dir"
        if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
            linked_ok=$((linked_ok + 1))
        else
            linked_bad=$((linked_bad + 1))
            printf "  ${RED}✘${RESET} ~/.config/%-12s (not linked to %s)\n" "$dir" "$src"
        fi
    done
    for rc in .zshrc .tmux.conf .vimrc; do
        if [[ -L "$HOME/$rc" ]]; then
            linked_ok=$((linked_ok + 1))
        else
            linked_bad=$((linked_bad + 1))
            printf "  ${RED}✘${RESET} ~/%-18s (not a symlink)\n" "$rc"
        fi
    done
    if [[ "$linked_bad" -eq 0 ]]; then
        printf "  ${GREEN}✔${RESET} All %d symlinks (~/.config/*, ~/.zshrc, ~/.tmux.conf, ~/.vimrc) are active and valid.\n" "$linked_ok"
    else
        printf "  ${YELLOW}!${RESET} %d linked, %d missing/broken (run 'adot links' to fix).\n" "$linked_ok" "$linked_bad"
    fi

    section "Embedded Git Subtrees (nvim, tmux, ghostty, kitty, foot, vim)"
    printf "  ${BOLD}%-10s %-15s %-34s %-s${RESET}\n" "MODULE" "REMOTE" "LAST LOCAL TOUCH" "UPSTREAM REPOSITORY"
    printf "  %-10s %-15s %-34s %-s\n" "----------" "---------------" "----------------------------------" "------------------------------------------------"
    for mod in "${SUBTREE_MODULES[@]}"; do
        local rname="${mod}-remote"
        local rurl
        rurl="$(get_subtree_url "$mod")"
        local last_touch
        last_touch="$(git -C "$DOTFILES_DIR" log -1 --format="%h (%cr)" -- "$mod" 2>/dev/null || echo "n/a")"
        if (( do_fetch )); then
            git -C "$DOTFILES_DIR" fetch "$rname" main >/dev/null 2>&1 || true
            local remote_sha
            remote_sha="$(git -C "$DOTFILES_DIR" rev-parse --short "$rname/main" 2>/dev/null || echo "?")"
            last_touch="$last_touch [up:$remote_sha]"
        fi
        printf "  %-10s %-15s %-34s %s\n" "$mod/" "$rname" "$last_touch" "$rurl"
    done
    if (( ! do_fetch )); then
        printf "  ${DIM}(Tip: run 'adot status --fetch' to also fetch remote SHA hashes from GitHub)${RESET}\n"
    fi

    section "Shell, Wallpapers & Arch Packages"
    if [[ -d "$HOME/.oh-my-zsh/.git" ]]; then
        local omz_sha
        omz_sha="$(git -C "$HOME/.oh-my-zsh" log -1 --format="%h (%cr)" 2>/dev/null || echo "installed")"
        printf "  ${GREEN}✔${RESET} %-22s %s\n" "Oh My Zsh:" "~/.oh-my-zsh ($omz_sha)"
    else
        printf "  ${YELLOW}!${RESET} %-22s %s\n" "Oh My Zsh:" "not installed (run 'adot install')"
    fi

    if command -v zoxide >/dev/null 2>&1; then
        printf "  ${GREEN}✔${RESET} %-22s %s\n" "zoxide ('j' / 'ji'):" "$(zoxide --version 2>/dev/null || echo "installed")"
    else
        printf "  ${YELLOW}!${RESET} %-22s %s\n" "zoxide ('j' / 'ji'):" "not installed"
    fi

    if [[ -d "$DOTFILES_DIR/pictures/.git" ]]; then
        local wp_count
        wp_count="$(find "$DOTFILES_DIR/pictures" -maxdepth 3 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | wc -l | tr -d ' ')"
        printf "  ${GREEN}✔${RESET} %-22s %s (%s images)\n" "Wallpaper Repo:" "$DOTFILES_DIR/pictures" "$wp_count"
    else
        printf "  ${DIM}•${RESET} %-22s %s\n" "Wallpaper Repo:" "not cloned (optional: 'adot wallpapers <git-url>')"
    fi

    if command -v pacman >/dev/null 2>&1; then
        local pkg_installed=0 pkg_missing=0
        local missing_list=()
        for pkg in "${PACMAN_PACKAGES[@]}"; do
            if pacman -Qi "$pkg" >/dev/null 2>&1; then
                pkg_installed=$((pkg_installed + 1))
            else
                pkg_missing=$((pkg_missing + 1))
                missing_list+=("$pkg")
            fi
        done
        if [[ "$pkg_missing" -eq 0 ]]; then
            printf "  ${GREEN}✔${RESET} %-22s All %d managed pacman packages are installed.\n" "Arch Packages:" "$pkg_installed"
        else
            printf "  ${YELLOW}!${RESET} %-22s %d/%d installed (missing: %s — run 'adot packages')\n" \
                "Arch Packages:" "$pkg_installed" "${#PACMAN_PACKAGES[@]}" "${missing_list[*]}"
        fi
    fi
    echo ""
}

# ============================================================================
# 8. LISTING & REFERENCE ENGINE (Modules, Subtrees, Commands, Scripts, Keys)
# ============================================================================
list_modules() {
    section "Managed Configuration Modules (${#CONFIG_DIRS[@]} directories)"
    printf "  ${BOLD}%-12s %-28s %-s${RESET}\n" "MODULE" "SYMLINK TARGET" "DESCRIPTION"
    printf "  %-12s %-28s %-s\n" "------------" "----------------------------" "------------------------------------------------------------"
    for dir in "${CONFIG_DIRS[@]}"; do
        printf "  %-12s %-28s %s\n" "$dir/" "~/.config/$dir" "$(get_module_desc "$dir")"
    done
    printf "  %-12s %-28s %s\n" "zsh/zshrc" "~/.zshrc" "Primary Zsh startup file"
    printf "  %-12s %-28s %s\n" "tmux/..." "~/.tmux.conf" "Primary tmux configuration entry point"
    printf "  %-12s %-28s %s\n" "vim/vimrc" "~/.vimrc" "Primary standalone Vim configuration"
    echo ""
}

list_docs() {
    section "Connected Read the Docs Documentation Hub"
    printf "  ${BOLD}%-18s %-48s %-s${RESET}\n" "PROJECT" "READ THE DOCS URL" "GITHUB REPOSITORY"
    printf "  %-18s %-48s %-s\n" "------------------" "------------------------------------------------" "---------------------------------------------------"
    printf "  %-18s %-48s %s\n" "arch-dotfiles"  "https://arch-dotfiles.readthedocs.io/en/latest/"  "https://github.com/MichaelWeissDEV/dotfiles"
    printf "  %-18s %-48s %s\n" "nvim-config"    "https://nvim-config.readthedocs.io/en/latest/"    "https://github.com/MichaelWeissDEV/nvim-config"
    printf "  %-18s %-48s %s\n" "tmux-config"    "https://tmux-config.readthedocs.io/en/latest/"    "https://github.com/MichaelWeissDEV/tmux-config"
    printf "  %-18s %-48s %s\n" "ghostty-config" "https://ghostty-config.readthedocs.io/en/latest/" "https://github.com/MichaelWeissDEV/ghostty-config"
    printf "  %-18s %-48s %s\n" "kitty-config"   "https://kitty-config.readthedocs.io/en/latest/"   "https://github.com/MichaelWeissDEV/kitty-config"
    printf "  %-18s %-48s %s\n" "vim-config"     "https://vim-config.readthedocs.io/en/latest/"     "https://github.com/MichaelWeissDEV/vim-config"
    echo ""
}

list_scripts() {
    section "Managed CLI Programs & Helper Scripts"
    cat <<EOF
  ${BOLD}Global CLI Binaries (linked in ~/.local/bin):${RESET}
    adot                       Primary CLI program for managing the entire dotfiles ecosystem
    arch-dot / arch-dotfiles   Full-name aliases for 'adot' in ~/.local/bin
    wallpaper (alias: wp)      Multi-monitor wallpaper manager for hyprpaper (CLI + Fuzzel TUI)

  ${BOLD}Repository Scripts (~/git/dotfiles/scripts/ — called automatically by 'adot'):${RESET}
    scripts/adot                   Unified CLI manager (install, update, status, list, keys, commands, ...)
    scripts/install.sh             Installer entry point (delegates to 'adot')
    scripts/install-links.sh       Symlink-only setup helper ('adot links')
    scripts/update-subtrees.sh     Git subtree synchronization engine ('adot subtrees' / 'adot push')
    scripts/install-wallpapers.sh  Private wallpaper repository manager ('adot wallpapers')

  ${BOLD}Desktop & Hyprland Scripts (~/git/dotfiles/hypr/ & wallpaper/):${RESET}
    hypr/windowswitcher.sh         Cross-monitor Fuzzel window & slot switcher (SUPER + G / SUPER + #)
    hypr/powermenu.sh              Top-right Fuzzel system power menu (SUPER + Escape / right-click 󰐥)
    hypr/askpass.sh                Graphical Wayland sudo password prompt via Fuzzel (SUDO_ASKPASS)
    wallpaper/wallpaper.sh         Backend script for 'wallpaper' CLI and Fuzzel TUI (SUPER + SHIFT + W)
EOF
    echo ""
}

list_commands() {
    section "Custom CLI Commands, Shell Functions & Aliases"
    cat <<EOF
  ${BOLD}1. Ecosystem & System Management ('adot' / 'arch-dot' / 'arch-dotfiles'):${RESET}
    adot install                   Full Arch Linux setup (pacman, subtrees, Oh My Zsh, symlinks, services)
    adot update                    Update EVERYTHING (pacman, dotfiles, all 6 subtrees, wallpapers, OMZ, links)
    adot update <target>           Update a single target: nvim | tmux | ghostty | kitty | foot | vim | subtrees |
                                   dotfiles | system | zsh | wallpapers | links
    adot status [--fetch]          Show live status of repo, symlinks, all 6 subtrees, OMZ & pacman packages
    adot list [category]           List modules, subtrees, keys, commands, scripts, packages, links, or docs
    adot keys [section]            Show keybindings (all | hypr | vim | nvim | tmux | terminals | shell)
    adot commands                  Show this overview of all custom commands, functions & aliases
    adot scripts                   Show all managed scripts and CLI binaries
    adot subtrees [mod]            Pull all 6 Git subtrees (or a single subtree) from upstream GitHub
    adot push [mod|all]            Push local subtree commits back to upstream GitHub repositories
    adot links                     Create/refresh all symlinks in ~/.config, ~, and ~/.local/bin
    adot packages                  Install/update all managed Arch Linux packages via pacman
    adot wallpapers [URL|--update] Clone or update private wallpaper repository in ~/git/dotfiles/pictures
    adot docs                      Display all 6 Read the Docs documentation URLs

  ${BOLD}2. Smart Navigation & File Management (zsh/zshrc & zsh/aliases.zsh):${RESET}
    j <pattern>   (also: z)        Smart directory JUMP powered under the hood by zoxide (frecency-based)
    ji            (also: zi)       Interactive fzf directory jump picker powered by zoxide
    j -           (also: z -)      Jump back to previous directory
    y [path]                       Launch Yazi TUI file manager and auto-cd into last directory on exit ('q')
    dotfiles                       cd ~/git/dotfiles

  ${BOLD}3. Editors & Interactive Fuzzy Openers:${RESET}
    nv                             Launch Neovim (nvim-config)
    v                              Launch standalone Vim (vim-config)
    fznv                           Fuzzy-find file with fzf and open in Neovim
    fzv                            Fuzzy-find file with fzf and open in Vim

  ${BOLD}4. tmux Session Helpers:${RESET}
    tm                             Attach to main tmux session (or create it if not running)
    tn <name>                      Create a new named tmux session
    ta <name>                      Attach to an existing named tmux session
    tl                             List all active tmux sessions

  ${BOLD}5. Multi-Monitor Wallpaper Switcher ('wallpaper' / 'wp'):${RESET}
    wallpaper                      Open interactive Fuzzel TUI (choose monitor target + wallpaper)
    wallpaper list                 List all discovered wallpapers (★ = Default, ● = Monitor Override)
    wallpaper set <img|path>       Set global default wallpaper (or add --monitor <MON> / --all)
    wallpaper monitor <MON> <img>  Set or clear ('default') per-monitor wallpaper override
    wallpaper current              Show active wallpaper assignments per monitor
    wallpaper next / prev / random Cycle through wallpapers or pick a random one
    wallpaper add <file> --set     Copy image into ~/git/dotfiles/pictures and apply immediately

  ${BOLD}6. Short Maintenance Aliases:${RESET}
    cfg-update                     Alias for 'adot update'
    cfg-links                      Alias for 'adot links'
    cfg-subtrees                   Alias for 'adot subtrees'
    cfg-wallpapers                 Alias for 'adot wallpapers'
    ll / la / ls                   Colorized ls (-lah / -A)
EOF
    echo ""
}

list_keys() {
    local filter="${1:-all}"

    if [[ "$filter" == "all" || "$filter" == "hypr" || "$filter" == "hyprland" ]]; then
        section "Hyprland Keybindings (~/.config/hypr/hyprland.lua)"
        cat <<EOF
  ${BOLD}Apps & System (SUPER = Windows/Super Key):${RESET}
    SUPER + Space (or ALT+Space, SUPER+D/R/A)  Open Fuzzel app launcher
    SUPER + Return (or SUPER + Q)              Open default terminal (Kitty)
    SUPER + SHIFT + Return                     Open terminal attached to persistent tmux session 'main'
    SUPER + E / SUPER + Y / SUPER + B          Open PCManFM (GUI files) / Yazi (TUI files) / Firefox
    SUPER + SHIFT + W                          Open interactive Wallpaper TUI ('wallpaper')
    SUPER + SHIFT + B                          Reload / restart Waybar
    SUPER + L / SUPER + Escape                 Lock screen (hyprlock) / Open Fuzzel Power Menu
    SUPER + SHIFT + E (or SUPER + M)           Exit Hyprland session back to TTY
    Print / SUPER + SHIFT + P                  Full screenshot / Region screenshot (~/Downloads + clipboard)

  ${BOLD}Cross-Monitor Window Switching & Pinning Slots (1..10 & F1..F4):${RESET}
    ALT + Tab (or SUPER+Tab / SUPER+BackSpace) Instant Ping-Pong Jump to last active window across all monitors
    ALT + SHIFT + Tab (or SUPER + SHIFT + Tab) Cycle through all open windows across all monitors & workspaces
    SUPER + ^ (key below Escape)               Cycle through windows of the same application class
    SUPER + G (or SUPER + #)                   Open interactive Fuzzel Window & Slot Switcher (windowswitcher.sh)
    SUPER + CTRL + 1..9, 0                     Pin/save active window to cross-monitor Slot 1..10
    SUPER + ALT + 1..9, 0                      Jump to window in Slot 1..10 (press again to jump back!)
    SUPER + CTRL + F1..F4 (or SUPER+SHIFT+F1..) Pin/save active window to Quick Slot 1..4
    SUPER + F1..F4                             Single-chord Quick Jump to Slot 1..4 (or back)
    SUPER + O (or SUPER + <)                   Focus next physical monitor
    SUPER + SHIFT + O / SUPER + CTRL + O       Move window to next monitor / Swap workspaces between monitors

  ${BOLD}Workspaces & Window Tiling:${RESET}
    SUPER + 1..9, 0 / SUPER + SHIFT + 1..9, 0  Switch to workspace 1..10 / Move window to workspace 1..10
    CTRL + ALT + 1..9, 0                       Switch to workspace/monitor 1..10 ONLY if it already exists
    CTRL + ALT + Left / Right                  Previous / next workspace (r-1 / r+1)
    SUPER + . / SUPER + , / SUPER + N          Next workspace (r+1) / Prev workspace (r-1) / Next empty workspace
    SUPER + S / SUPER + SHIFT + S              Toggle scratchpad (special:magic) / Move window to scratchpad
    SUPER + C (or SUPER + W)                   Close active window
    SUPER + F / SUPER + SHIFT + F / SUPER + V  Toggle fullscreen / Toggle maximize / Toggle floating
    SUPER + CTRL + C / SUPER + T / SUPER + P   Center floating window / Toggle split dir / Toggle pseudo-tile
    SUPER + Arrow Keys                         Move focus directionally (crosses monitor edges automatically)
    SUPER + SHIFT + Arrow Keys                 Move/swap window directionally
    SUPER + CTRL + Arrow Keys                  Resize active window (40px steps)
EOF
    fi

    if [[ "$filter" == "all" || "$filter" == "nvim" || "$filter" == "neovim" ]]; then
        section "Neovim Keybindings (nvim-config — Leader = <Space>)"
        cat <<EOF
    <Space>                   Open which-key popup (or run :NvimKeymaps / :NvimCommands)
    <Space>ff / <Space>fg     Find files / Live grep (Telescope)
    <Space>fb / <Space>fh     Buffers / Help tags
    <Space>e                  Toggle file explorer sidebar (nvim-tree)
    <Space>o  (or -)          Open parent directory as editable buffer (Oil)
    <Space>tl / <Space>ti     :LangInstall (install LSP/formatter/linter/parser) / :LangInfo
    gd / gr / gi / gy / K     LSP definition / references / implementation / type def / hover
    <Space>lr / <Space>la     LSP rename symbol / code action
    <Space>lf                 Format current buffer
    <Space>db / <Space>dc     Toggle debug breakpoint / Start or continue debugger (nvim-dap)
    <Space>cr / <Space>ct     Run current file / Run pytest on file
    Ctrl + /  (or <Space>tt)  Toggle floating/split terminal
    Ctrl + h / j / k / l      Navigate between window splits
EOF
    fi

    if [[ "$filter" == "all" || "$filter" == "vim" ]]; then
        section "Vim Keybindings (vim-config — Leader = <Space>)"
        cat <<EOF
    <Space>un / <Space>rn / <Space>n / <F3>  Toggle Relative (Hybrid) <-> Absolute line numbers (:ToggleRelNum)
    <Space>uN                                Toggle line numbers completely On / Off
    Ctrl + h / j / k / l                     Navigate between split windows
    <Space>wv / <Space>ws / <Space>wc / <Space>we  Vertical split / Horizontal split / Close / Equalize splits
    Shift + H / Shift + L / <Space>bd        Previous buffer / Next buffer / Delete buffer
    <Space>y / <Space>Y                      Copy selection / line to system clipboard (+ register)
    <Space>uw / <Space>ul / <Esc>            Toggle wrap / Toggle listchars / Clear search highlight
EOF
    fi

    if [[ "$filter" == "all" || "$filter" == "tmux" ]]; then
        section "tmux Keybindings (tmux-config — Prefix = Ctrl+b)"
        cat <<EOF
    Prefix + H                Open interactive Key Explorer popup (search all bindings live)
    Prefix + |  (or v)        Split pane horizontally (side by side, in current directory)
    Prefix + _  (or s)        Split pane vertically (stacked, in current directory)
    Prefix + h / j / k / l    Select pane left / down / up / right
    Prefix + z                Toggle pane zoom (fullscreen within tmux)
    Prefix + c                Create new tmux window in current directory
    Prefix + d                Detach from session (re-attach with 'tm' or SUPER+SHIFT+Return)
    Prefix + R  (or r)        Reload ~/.config/tmux/tmux.conf live
EOF
    fi

    if [[ "$filter" == "all" || "$filter" == "terminals" || "$filter" == "kitty" || "$filter" == "ghostty" ]]; then
        section "Terminal Keybindings (Kitty & Ghostty)"
        cat <<EOF
    Ctrl + Shift + C / V      Copy to clipboard / Paste from clipboard
    Ctrl + Shift + T          Open new tab
    Ctrl + Shift + F5         Live-reload Kitty config (~/.config/kitty/kitty.conf)
    Ctrl + Shift + ,          Live-reload Ghostty config (~/.config/ghostty/config)
    Ctrl + Shift + = / -      Increase / decrease font size (Kitty; Ctrl + =/- in Ghostty)
EOF
    fi

    if [[ "$filter" == "all" || "$filter" == "shell" || "$filter" == "zsh" ]]; then
        section "Zsh & Shell Shortcuts (~/.config/zsh/zshrc)"
        cat <<EOF
    Esc Esc                   Prepend 'sudo' to current or previous command (Oh My Zsh sudo plugin)
    Right Arrow (→)           Accept inline autosuggestion (zsh-autosuggestions)
    Ctrl + R                  Fuzzy search shell command history (fzf)
    Ctrl + T / Alt + C        Fuzzy insert file path / Fuzzy cd into subdirectory (fzf)
    j <dir> / ji              Smart directory jump / Interactive fzf directory jump (powered by zoxide)
EOF
    fi
    echo ""
}

list_packages() {
    section "Managed Arch Linux Packages (${#PACMAN_PACKAGES[@]} packages)"
    for pkg in "${PACMAN_PACKAGES[@]}"; do
        if command -v pacman >/dev/null 2>&1 && pacman -Qi "$pkg" >/dev/null 2>&1; then
            local ver
            ver="$(pacman -Qi "$pkg" | awk -F': ' '/^Version/ {print $2; exit}')"
            printf "  ${GREEN}✔${RESET} %-30s %s\n" "$pkg" "$ver"
        else
            printf "  ${DIM}•${RESET} %-30s (not installed)\n" "$pkg"
        fi
    done
    echo ""
}

handle_list() {
    local what="${1:-all}"
    case "$what" in
        all)
            list_modules
            "$SCRIPTS_DIR/update-subtrees.sh" status
            list_scripts
            list_commands
            list_docs
            ;;
        modules|mods|configs|links|symlinks)
            list_modules
            ;;
        subtrees|subtree)
            "$SCRIPTS_DIR/update-subtrees.sh" status
            ;;
        keys|keybindings|binds|shortcuts)
            shift || true
            list_keys "${1:-all}"
            ;;
        commands|cmds|aliases|functions)
            list_commands
            ;;
        scripts|bins|binaries|tools)
            list_scripts
            ;;
        packages|pkgs|pacman)
            list_packages
            ;;
        docs|urls|rtd)
            list_docs
            ;;
        *)
            error "Unknown list category: '$what'"
            echo "Available categories: all, modules, subtrees, keys, commands, scripts, packages, docs"
            exit 1
            ;;
    esac
}

push_dotfiles_repo() {
    if ! git -C "$DOTFILES_DIR" remote get-url origin >/dev/null 2>&1; then
        error "No 'origin' remote configured in $DOTFILES_DIR."
        return 1
    fi

    if [[ -f "$DOTFILES_DIR/.git/MERGE_HEAD" ]]; then
        error "An unfinished Git merge is active in $DOTFILES_DIR! Resolve or abort before pushing."
        return 1
    fi

    if [[ -n "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
        warn "Uncommitted changes exist in $DOTFILES_DIR (commit them first so they are included in the push)."
    fi

    local branch
    branch="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
    info "Pushing main dotfiles repository ($DOTFILES_DIR -> origin/$branch)..."
    git -C "$DOTFILES_DIR" push origin "$branch"
    ok "Main dotfiles repository pushed to origin/$branch."
}

push_target() {
    local target="${1:-all}"
    case "$target" in
        all)
            section "1/2 Pushing Central Dotfiles Repository ($DOTFILES_DIR -> origin)"
            push_dotfiles_repo

            section "2/2 Pushing Embedded Git Subtrees (${SUBTREE_MODULES[*]})"
            "$SCRIPTS_DIR/update-subtrees.sh" push all

            if [[ -d "$DOTFILES_DIR/pictures/.git" ]]; then
                section "Pushing Private Wallpaper Repository (pictures/)"
                git -C "$DOTFILES_DIR/pictures" push
                ok "Private wallpaper repository pushed."
            fi

            printf "\n"
            ok "All updates pushed to remote repositories ('adot push')!"
            ;;
        dotfiles|main|repo|origin|self)
            section "Pushing Central Dotfiles Repository ($DOTFILES_DIR -> origin)"
            push_dotfiles_repo
            ;;
        subtrees|subtree)
            section "Pushing All 6 Git Subtrees (${SUBTREE_MODULES[*]})"
            "$SCRIPTS_DIR/update-subtrees.sh" push "${2:-all}"
            ;;
        nvim|tmux|ghostty|kitty|foot|vim)
            section "Pushing Git Subtree: $target"
            "$SCRIPTS_DIR/update-subtrees.sh" push "$target"
            ;;
        wallpapers|pictures|wp)
            if [[ -d "$DOTFILES_DIR/pictures/.git" ]]; then
                section "Pushing Private Wallpaper Repository (pictures/)"
                git -C "$DOTFILES_DIR/pictures" push
                ok "Private wallpaper repository pushed."
            else
                warn "No private wallpaper git repo in pictures/."
            fi
            ;;
        *)
            error "Unknown push target: '$target'"
            echo "Valid targets: all, dotfiles, subtrees, nvim, tmux, ghostty, kitty, foot, vim, wallpapers"
            exit 1
            ;;
    esac
}

# ============================================================================
# 9. HELP & CLI DISPATCHER
# ============================================================================
usage() {
    cat <<EOF
${BOLD}adot${RESET} (also: ${BOLD}arch-dot${RESET} / ${BOLD}arch-dotfiles${RESET}) — Unified Arch Linux Dotfiles & Ecosystem Manager

${BOLD}USAGE:${RESET}
  adot <command> [arguments...]

${BOLD}SETUP & UPDATE COMMANDS:${RESET}
  ${TEAL}install${RESET}                     Complete Arch Linux setup (pacman packages, subtrees, Oh My Zsh, symlinks, services)
  ${TEAL}update${RESET} [target]             Update everything (default) or a specific component:
                              • ${BOLD}adot update${RESET}            Update system packages, dotfiles, all 6 subtrees, wallpapers, OMZ & links
                              • ${BOLD}adot update <subtree>${RESET}  Update only one subtree (nvim | tmux | ghostty | kitty | foot | vim)
                              • ${BOLD}adot update subtrees${RESET}   Update all 6 Git subtrees from upstream
                              • ${BOLD}adot update dotfiles${RESET}   Pull only the main ~/git/dotfiles repository
                              • ${BOLD}adot update system${RESET}     Update only Arch Linux pacman packages
                              • ${BOLD}adot update zsh${RESET}        Update only Oh My Zsh & Zsh plugins
                              • ${BOLD}adot update wallpapers${RESET} Update only the private wallpaper repository
  ${TEAL}links${RESET}                       Create/refresh all symlinks in ~/.config, ~, and ~/.local/bin (no sudo required)
  ${TEAL}packages${RESET}                    Install/update all ${#PACMAN_PACKAGES[@]} managed Arch Linux packages via pacman

${BOLD}INSPECTION, LISTING & REFERENCE COMMANDS:${RESET}
  ${TEAL}status${RESET} [--fetch]            Show live dashboard (repo state, symlinks, subtree commits, OMZ, zoxide & packages)
  ${TEAL}list${RESET} [category]             List managed items:
                              • ${BOLD}adot list${RESET}              Full overview (modules, subtrees, scripts, commands & docs)
                              • ${BOLD}adot list modules${RESET}      List all ${#CONFIG_DIRS[@]} managed ~/.config modules & symlink targets
                              • ${BOLD}adot list subtrees${RESET}     List all 6 embedded Git subtrees & remote URLs
                              • ${BOLD}adot list keys${RESET} [sec]   List custom keybindings (hypr|nvim|vim|tmux|terminals|shell|all)
                              • ${BOLD}adot list commands${RESET}     List all custom CLI commands, aliases & shell functions (incl. 'j' zoxide)
                              • ${BOLD}adot list scripts${RESET}      List all managed scripts & ~/.local/bin executables
                              • ${BOLD}adot list packages${RESET}     List all ${#PACMAN_PACKAGES[@]} managed Arch Linux packages & installed versions
                              • ${BOLD}adot list docs${RESET}         List all 6 Read the Docs URLs & GitHub repositories
  ${TEAL}keys${RESET} [section]              Shortcut for 'adot list keys [hypr|nvim|vim|tmux|terminals|shell|all]'
  ${TEAL}commands${RESET}                    Shortcut for 'adot list commands'
  ${TEAL}scripts${RESET}                     Shortcut for 'adot list scripts'
  ${TEAL}docs${RESET}                        Shortcut for 'adot list docs'

${BOLD}SUBTREE & WALLPAPER COMMANDS:${RESET}
  ${TEAL}subtrees${RESET} [mod|status]       Pull all 6 Git subtrees (or specify: nvim | tmux | ghostty | kitty | foot | vim | status)
  ${TEAL}push${RESET} [target]               Push commits to GitHub (all | dotfiles | subtrees | nvim | tmux | ghostty | kitty | foot | vim)
  ${TEAL}wallpapers${RESET} [URL|--update]   Clone or update the private wallpaper repository in ~/git/dotfiles/pictures
  ${TEAL}path${RESET}                        Print the dotfiles repository path ($DOTFILES_DIR)
  ${TEAL}help${RESET}                        Show this help message
EOF
}

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        install|setup|init)
            install_packages
            setup_subtrees
            setup_oh_my_zsh
            setup_links
            setup_system
            ok "Complete Arch Dotfiles setup finished successfully!"
            ;;
        update|upgrade|up)
            shift || true
            update_target "${1:-all}" "${2:-}"
            ;;
        status|st|info|check)
            shift || true
            show_status "${1:-}"
            ;;
        list|ls)
            shift || true
            handle_list "$@"
            ;;
        keys|keybindings|binds|shortcuts)
            shift || true
            list_keys "${1:-all}"
            ;;
        commands|cmds|aliases)
            list_commands
            ;;
        scripts|bins)
            list_scripts
            ;;
        docs|urls)
            list_docs
            ;;
        modules|mods)
            list_modules
            ;;
        subtrees|subtree|pull)
            shift || true
            update_subtrees "${1:-all}"
            ;;
        push)
            shift || true
            push_target "${1:-all}" "${2:-}"
            ;;
        packages|pkgs)
            install_packages
            ;;
        links|symlinks)
            setup_links
            ;;
        wallpapers|pictures|wp)
            shift || true
            "$SCRIPTS_DIR/install-wallpapers.sh" "${@:---update}"
            ;;
        cd|path|dir)
            echo "$DOTFILES_DIR"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            error "Unknown command: '$cmd'"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
