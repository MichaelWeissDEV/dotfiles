# ============================================================================
# ~/git/dotfiles/.gitignore - Git-Ignore für das Dotfiles-Repository
# ============================================================================

# Temporäre Editor-, Log- & Backup-Dateien ausschließen
*.log
*.bak
*.swp
*~
.DS_Store

# Lokale Tmux-Overrides (falls angelegt)
tmux/local.conf
tmux/local-options.conf
