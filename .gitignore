# ============================================================================
# ~/git/dotfiles/.gitignore - Git-Ignore für das Dotfiles-Repository
# ============================================================================

# Temporäre Editor-, Log- & Backup-Dateien ausschließen
*.log
*.bak
*.swp
*~
.DS_Store

# Lokale Tmux-Overrides (falls angelegt)
packages/arch-dotfiles-tmux/config/local.conf
packages/arch-dotfiles-tmux/config/local-options.conf

# Individuelle Monitor-Anordnung (pro Rechner, nicht versionieren)
packages/arch-dotfiles-hypr/config/monitors.local.lua

# Dokumentations-Builds (Sphinx & MkDocs)
_build/
docs/_build/
**/docs/_build/
.venv/
__pycache__/

# Privates Wallpaper-Repository (Urheberrecht)
# Wird separat geklont und ist bewusst NICHT Teil des öffentlichen Dotfiles-Repos.
# Einrichtung: ~/git/dotfiles/scripts/install-wallpapers.sh <git-url>
pictures/

# Arch package build output (contains generated sources and binary packages)
packaging/arch/build/
packaging/arch/repo/
.sources/
/sources.json
