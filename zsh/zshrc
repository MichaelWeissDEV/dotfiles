# ============================================================================
# ~/.config/zsh/zshrc - Hauptkonfiguration für Zsh
# ============================================================================

export ZSH="$HOME/.oh-my-zsh"
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"
export VISUAL="nvim"
export SUDO_ASKPASS="$HOME/.config/hypr/askpass.sh"

# Theme laden (~/.oh-my-zsh/custom/themes/catppuccin.zsh-theme)
ZSH_THEME="catppuccin"

# Schnelle Updates ohne Rückfrage
zstyle ':omz:update' mode auto

# Plugins (inkl. Fisch-ähnlicher Autovervollständigung & Syntax-Highlighting)
plugins=(
    git
    sudo
    zsh-autosuggestions
    zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# Minimaler Prompt (> )
PROMPT='> '

# ============================================================================
# CATPPUCCIN MOCHA FARBEN FÜR PLUGINS & TOOLS
# ============================================================================
# Dezentes Overlay0 (#6c7086) für Vorschläge während des Tippens
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#6c7086"

# Catppuccin Mocha Farben für zsh-syntax-highlighting
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#89b4fa,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#94e2d5,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#cba6f7,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=#89b4fa,bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8,bold'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#a6e3a1'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#a6e3a1'
ZSH_HIGHLIGHT_STYLES[path]='fg=#b4befe,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#fab387'
ZSH_HIGHLIGHT_STYLES[option]='fg=#f9e2af'

# Catppuccin Mocha Farbschema für TUI-Programme wie nmtui
export NEWT_COLORS='
root=white,black
border=blue,black
window=white,black
shadow=black,black
title=cyan,black
button=black,blue
actbutton=black,cyan
compactbutton=white,black
checkbox=white,black
actcheckbox=black,blue
entry=white,black
disentry=gray,black
label=cyan,black
listbox=white,black
actlistbox=black,blue
sellistbox=black,cyan
actsellistbox=black,cyan
textbox=white,black
acttextbox=black,blue
emptyscale=black,black
fullscale=blue,blue
helpline=cyan,black
roottext=blue,black
'

# ============================================================================
# FZF, Zoxide Shell-Integration & Aliases laden
# ============================================================================
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

if command -v zoxide >/dev/null 2>&1; then
    # Initialize zoxide with 'j' (jump) & 'ji' (interactive fzf jump), plus standard 'z' & 'zi'
    eval "$(zoxide init zsh --cmd j)"
fi

if [[ -f "$HOME/.config/zsh/aliases.zsh" ]]; then
    source "$HOME/.config/zsh/aliases.zsh"
fi


# Added by Antigravity CLI installer
export PATH="/home/mweiss/.local/bin:$PATH"
